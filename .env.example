# Initialization does not read environment variables or call external services.
# Reserved for a future server-side Fuyao integration; not implemented yet.
# Keep real credentials in .env.local. Never use a NEXT_PUBLIC_ prefix for keys.
# Standard REST authentication uses the X-api-key header, not login cookies.
FUYAO_BASE_URL=https://fuyao.aicubes.cn
FUYAO_API_KEY=

# No automatic AI integration or model credentials are configured in this phase.
